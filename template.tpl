// Synapse Client: turns requests of the Synapse Tag and of server-to-server
// senders (for example offline purchases) into event data for the server tags.
const claimRequest = require('claimRequest');
const computeEffectiveTldPlusOne = require('computeEffectiveTldPlusOne');
const decodeUriComponent = require('decodeUriComponent');
const encodeUriComponent = require('encodeUriComponent');
const fromBase64 = require('fromBase64');
const generateRandom = require('generateRandom');
const getClientName = require('getClientName');
const getCookieValues = require('getCookieValues');
const getRemoteAddress = require('getRemoteAddress');
const getRequestBody = require('getRequestBody');
const getRequestHeader = require('getRequestHeader');
const getRequestMethod = require('getRequestMethod');
const getRequestPath = require('getRequestPath');
const getRequestQueryParameter = require('getRequestQueryParameter');
const getRequestQueryParameters = require('getRequestQueryParameters');
const getTimestampMillis = require('getTimestampMillis');
const getType = require('getType');
const JSON = require('JSON');
const makeInteger = require('makeInteger');
const makeString = require('makeString');
const Object = require('Object');
const returnResponse = require('returnResponse');
const runContainer = require('runContainer');
const setCookie = require('setCookie');
const setPixelResponse = require('setPixelResponse');
const setResponseBody = require('setResponseBody');
const setResponseHeader = require('setResponseHeader');
const setResponseStatus = require('setResponseStatus');

const DEFAULT_PATH = '/data';
const CLIENT_ID_COOKIE = '_dcid';
// The Synapse Tag keeps stored user data in this cookie.
const STORE_COOKIE = 'synapse';
const TWO_YEARS = 63072000;
const ECOMMERCE_ACTIONS = ['detail', 'click', 'add', 'remove', 'checkout', 'checkout_option', 'purchase', 'refund'];
// Fields the stored data of the Synapse Tag may never fill (see addStoredData).
const NOT_FROM_STORE = ['event', 'event_name', 'client_id', 'timestamp', 'unique_event_id', 'consent_state', '_dcid_temp'];
let storeCache;
// Query keys that belong to the transport, not to the event: the cache-buster,
// the disguised-retry carrier and the rescue marker the Synapse logs count
// (_synr=1 retry, _synr=2 pixel without the sender script).
const TRANSPORT_KEYS = ['_r', 'ei', '_synr'];

const method = getRequestMethod();
// The disguised retry of the Synapse Tag ("ei" = base64url of "<path>?<query>")
// is unpacked by the edge worker; without a worker it is unpacked here and the
// request is handled as the path it hides.
const hidden = hiddenRequest();
const path = hidden ? hidden.path : getRequestPath();

if (isOwnPath(path)) handle();

function isOwnPath(requestPath) {
  if (requestPath === DEFAULT_PATH) return true;
  const extra = getType(data.path) === 'array' ? data.path : [];
  return extra.some((row) => row && row.path === requestPath);
}

function handle() {
  claimRequest();
  // The client's name as set in the container, for the Synapse logs. Encoded,
  // because a header value must be ASCII and a name can be in any script.
  const clientName = getClientName();
  if (clientName) setResponseHeader('x-synapse-client', encodeUriComponent(clientName));

  if (method === 'OPTIONS') {
    setCorsHeaders(200);
    returnResponse();
    return;
  }

  const read = readEvents();
  const events = read.events;
  const clientId = findClientId(events);
  events.forEach((event) => {
    addStoredData(event);
    completeEvent(event);
    event.client_id = clientId;
    if (event._dcid_temp) Object.delete(event, '_dcid_temp');
    // The Synapse Tag's rescue markers are for the logs, not for the tags.
    if (event._syntrim !== undefined) Object.delete(event, '_syntrim');
  });
  // The names of the events, for the Synapse logs: they see the address of a
  // request but not its body, so an event posted to any path (an offline
  // purchase, a CRM call) would otherwise have no name there. Each name is
  // encoded on its own, so a comma inside a name cannot split it.
  const names = [];
  events.forEach((event) => {
    const name = makeString(event.event_name || '');
    if (name && name !== 'undefined' && names.length < 10) names.push(encodeUriComponent(name.substring(0, 100)));
  });
  if (names.length) setResponseHeader('x-synapse-event', names.join(','));

  writeCookies(events[0], consentDeclined(events[0]));

  const status = makeInteger(data.responseStatusCode || 200);
  setCorsHeaders(status);

  let finished = 0;
  events.forEach((event) => {
    runContainer(event, () => {
      finished++;
      if (finished !== events.length) return;
      respond(status, events, read.single);
      returnResponse();
    });
  });
}

/*==============================================================================
  Reading the request
==============================================================================*/

// What the Synapse Tag keeps in the "synapse" cookie (rows set to Store) is
// added to an event that lacks it: a page that does not know the visitor's
// name or phone still sends what the visitor left on an earlier page. Only with
// consent to advertising, as the Synapse Tag reports it in consent_state; an
// event without a consent state gets nothing. A value the event has is kept.
function addStoredData(event) {
  if (!adConsent(event.consent_state)) return;
  const stored = storedData();
  for (let key in stored) {
    if (NOT_FROM_STORE.indexOf(key) !== -1) continue;
    const have = event[key];
    if (have === undefined || have === null || have === '') event[key] = stored[key];
  }
}

function storedData() {
  if (!storeCache) storeCache = readStored(getCookieValues(STORE_COOKIE, true)[0]);
  return storeCache;
}

// The "synapse" cookie of the Synapse Tag: readable pairs
// ("user_id:1|email_address:21d1..."), each name and value URL-encoded on its
// own; JSON from earlier versions is still read. Same rules as in the tag.
function readStored(text) {
  const out = {};
  if (!text) return out;
  let raw = makeString(text);
  if (raw.charAt(0) === '{' || raw.indexOf('%7B') === 0) {
    const saved = JSON.parse(raw.charAt(0) === '{' ? raw : decodeUriComponent(raw));
    if (getType(saved) === 'object') {
      for (let key in saved) {
        if (saved[key] !== undefined && saved[key] !== null && saved[key] !== '') out[key] = saved[key];
      }
    }
    return out;
  }
  if (raw.indexOf(':') === -1 && raw.indexOf('%3A') !== -1) raw = decodeUriComponent(raw) || '';
  raw.split('|').forEach((pair) => {
    const mark = pair.indexOf(':');
    if (mark < 1) return;
    const key = decodeUriComponent(pair.substring(0, mark));
    const value = decodeUriComponent(pair.substring(mark + 1));
    if (key && value) out[key] = value;
  });
  return out;
}

function formatStored(values) {
  return Object.keys(values)
    .map((key) => encodeUriComponent(key) + ':' + encodeUriComponent(makeString(values[key])))
    .join('|');
}

function adConsent(state) {
  if (getType(state) !== 'object') return false;
  const granted = (value) => value === true || value === 1 || value === 'true' || value === '1' || value === 'granted';
  const denied = (value) => value === false || value === 0 || value === 'false' || value === '0' || value === 'denied';
  return granted(state.ad_storage) && !denied(state.ad_user_data);
}

// One event per request, or one per array element when several are accepted.
// "single" means the body was one object (or no body at all was posted as one).
function readEvents() {
  const base = queryData();
  const body = getRequestBody();
  if (body) {
    const contentType = getRequestHeader('content-type');
    const isForm = !!contentType && contentType.indexOf('application/x-www-form-urlencoded') !== -1;
    const parsed = isForm ? parseForm(body) : JSON.parse(body);
    if (parsed) {
      const several = data.acceptMultipleEvents && getType(parsed) === 'array';
      const items = several ? parsed : [parsed];
      return {
        single: !several,
        events: items.map((item) => {
          const event = newEvent(base);
          for (let key in item) event[key] = item[key];
          return event;
        })
      };
    }
  }
  return { single: false, events: [newEvent(base)] };
}

function newEvent(base) {
  const event = {
    timestamp: makeInteger(getTimestampMillis() / 1000),
    unique_event_id: getTimestampMillis() + '_' + generateRandom(100000000, 999999999)
  };
  for (let key in base) event[key] = base[key];
  return event;
}

// Query parameters become event data; "dtdc" (base64 JSON) and "dtcd" (JSON)
// carry the packed data of a pixel. TRANSPORT_KEYS (the cache-buster, the
// disguise carrier, the rescue marker) are transport, not data.
function queryData() {
  const query = hidden ? hidden.query : getRequestQueryParameters();
  const event = {};
  if (!query) return event;
  for (let key in query) {
    if ((key === 'dtcd' || key === 'dtdc') && method === 'GET') {
      const packed = key === 'dtcd' ? JSON.parse(query[key]) : JSON.parse(fromBase64(query[key]));
      for (let inner in packed) event[inner] = packed[inner];
    } else if (TRANSPORT_KEYS.indexOf(key) === -1) {
      event[key] = query[key];
    }
  }
  return event;
}

function hiddenRequest() {
  const carrier = getRequestQueryParameter('ei');
  if (!carrier) return null;
  let encoded = makeString(carrier).split('-').join('+').split('_').join('/');
  while (encoded.length % 4) encoded += '=';
  const text = fromBase64(encoded);
  if (!text || text.charAt(0) !== '/') return null;
  const mark = text.indexOf('?');
  return {
    path: mark === -1 ? text : text.substring(0, mark),
    query: mark === -1 ? {} : parseQuery(text.substring(mark + 1))
  };
}

function parseQuery(text) {
  const query = {};
  text.split('&').forEach((pair) => {
    if (!pair) return;
    const mark = pair.indexOf('=');
    const key = mark === -1 ? pair : pair.substring(0, mark);
    const value = mark === -1 ? '' : pair.substring(mark + 1);
    query[decodeUriComponent(key.split('+').join(' '))] = decodeUriComponent(value.split('+').join(' '));
  });
  return query;
}

// A form body with dotted keys ("items.0.id=1") becomes nested objects and
// arrays; values that read as JSON (numbers, true) are converted.
function parseForm(text) {
  const result = {};
  text.split('&').forEach((pair) => {
    if (!pair) return;
    const mark = pair.indexOf('=');
    const rawKey = mark === -1 ? pair : pair.substring(0, mark);
    const rawValue = mark === -1 ? '' : pair.substring(mark + 1);
    const keys = rawKey.split('.').map((part) => decodeUriComponent(part.split('+').join(' ')));
    let node = result;
    for (let i = 0; i < keys.length - 1; i++) {
      if (!node[keys[i]]) {
        const next = keys[i + 1];
        node[keys[i]] = makeString(makeInteger(next)) === next ? [] : {};
      }
      node = node[keys[i]];
    }
    const text = decodeUriComponent(rawValue.split('+').join(' '));
    const value = JSON.parse(text) || text;
    if (getType(node) === 'array') node.push(value);
    else node[keys[keys.length - 1]] = value;
  });
  return result;
}

/*==============================================================================
  Completing the event for the server tags
==============================================================================*/

function completeEvent(event) {
  if (!event.event_name) event.event_name = event.eventName || event.event || event.e_n || 'Data';
  if (!event.ip_override) event.ip_override = event.ip || event.ipOverride || getRemoteAddress();
  if (!event.user_agent) {
    const agent = event.userAgent || getRequestHeader('User-Agent');
    if (agent) event.user_agent = agent;
  }
  if (!event.language) {
    const languages = getRequestHeader('Accept-Language');
    if (languages) event.language = languages.split(';')[0].substring(0, 2).toLowerCase();
  }
  fillFrom(event, 'page_hostname', ['pageHostname', 'hostname']);
  fillFrom(event, 'page_location', ['pageLocation', 'url', 'href']);
  fillFrom(event, 'page_referrer', ['pageReferrer', 'referrer', 'urlref']);
  if (!event.value && event.e_v) event.value = event.e_v;
  addItemFields(event);
  addEcommerceAction(event);
  fillFrom(event, 'page_encoding', ['pageEncoding']);
  fillFrom(event, 'page_path', ['pagePath']);
  fillFrom(event, 'page_title', ['pageTitle']);
  fillFrom(event, 'screen_resolution', ['screenResolution']);
  fillFrom(event, 'viewport_size', ['viewportSize']);
  fillFrom(event, 'user_id', ['userId']);
  if (!event.user_data) addUserData(event);
}

function fillFrom(event, field, aliases) {
  if (event[field]) return;
  for (let i = 0; i < aliases.length; i++) {
    if (event[aliases[i]]) {
      event[field] = event[aliases[i]];
      return;
    }
  }
}

// From the products: the currency, the fields of a single product and the
// total when the event has none.
function addItemFields(event) {
  const items = event.items;
  if (getType(items) !== 'array' || !items.length) return;
  const first = items[0] || {};
  if (!event.currency && first.currency) event.currency = first.currency;
  if (items.length === 1) {
    if (!event.item_id && first.item_id) event.item_id = first.item_id;
    if (!event.item_name && first.item_name) event.item_name = first.item_name;
    if (!event.item_brand && first.item_brand) event.item_brand = first.item_brand;
    if (!event.item_quantity && first.quantity) event.item_quantity = first.quantity;
    if (!event.item_category && first.item_category) event.item_category = first.item_category;
    if (!event.item_price && first.price) event.item_price = first.price;
  }
  if (!event.value) {
    let total = 0;
    items.forEach((item) => {
      if (!item || !item.price) return;
      total += (item.quantity ? item.quantity : 1) * item.price;
    });
    if (total) event.value = total;
  }
}

// Enhanced ecommerce objects of the older analytics format.
function addEcommerceAction(event) {
  if (!event.ecommerce) return;
  let action = null;
  for (let i = 0; i < ECOMMERCE_ACTIONS.length; i++) {
    if (event.ecommerce[ECOMMERCE_ACTIONS[i]]) {
      action = ECOMMERCE_ACTIONS[i];
      break;
    }
  }
  if (!action) return;
  if (!event['x-ga-mp1-pa']) event['x-ga-mp1-pa'] = action;
  const order = action === 'purchase' ? event.ecommerce.purchase.actionField : null;
  if (!order) return;
  if (!event['x-ga-mp1-tr']) event['x-ga-mp1-tr'] = order.revenue;
  if (!event.revenue) event.revenue = order.revenue;
  if (!event.affiliation) event.affiliation = order.affiliation;
  if (!event.tax) event.tax = order.tax;
  if (!event.shipping) event.shipping = order.shipping;
  if (!event.coupon) event.coupon = order.coupon;
  if (!event.transaction_id) event.transaction_id = order.id;
}

// Email, phone and address fields under their usual names become the
// user_data object the conversion tags read.
function addUserData(event) {
  const user = {};
  const address = {};
  const pick = (names) => {
    for (let i = 0; i < names.length; i++) {
      if (event[names[i]]) return event[names[i]];
    }
    return undefined;
  };
  const email = pick(['userEmail', 'email_address', 'email', 'mail']);
  if (email) user.email_address = email;
  const phone = pick(['userPhoneNumber', 'phone_number', 'phoneNumber', 'phone']);
  if (phone) user.phone_number = phone;
  if (event.street) address.street = event.street;
  if (event.city) address.city = event.city;
  if (event.region) address.region = event.region;
  if (event.country) address.country = event.country;
  const firstName = pick(['userFirstName', 'first_name', 'firstName', 'name']);
  if (firstName) address.first_name = firstName;
  const lastName = pick(['userLastName', 'last_name', 'lastName', 'surname', 'family_name', 'familyName']);
  if (lastName) address.last_name = lastName;
  if (!address.region && event.state) address.region = event.state;
  const postalCode = pick(['postal_code', 'postalCode', 'zip']);
  if (postalCode) address.postal_code = postalCode;
  if (Object.keys(address).length) user.address = address;
  if (Object.keys(user).length) event.user_data = user;
}

// The id of the event, the _dcid cookie, the temporary id of the tag, or a new one.
function findClientId(events) {
  for (let i = 0; i < events.length; i++) {
    const own = events[i].client_id || events[i].data_client_id || events[i]._dcid;
    if (own) return own;
  }
  const cookie = getCookieValues(CLIENT_ID_COOKIE)[0];
  if (cookie) return cookie;
  if (!data.generateClientId) return '';
  for (let i = 0; i < events.length; i++) {
    if (events[i]._dcid_temp) return events[i]._dcid_temp;
  }
  return 'dcid.1.' + getTimestampMillis() + '.' + generateRandom(100000000, 999999999);
}

/*==============================================================================
  Cookies
==============================================================================*/

function consentDeclined(event) {
  const mode = data.cookieStorageMode;
  if (mode === 'auto' && getType(event.consent_state) === 'object') {
    return event.consent_state[data.cookieConsentAutoParameter] === false;
  }
  if (mode === 'manual') {
    return ['0', 0, 'false', false, 'denied'].indexOf(data.cookieConsentManualValue) !== -1;
  }
  return false;
}

function writeCookies(event, declined) {
  if (declined) return;
  const options = (httpOnly) => ({
    domain: 'auto',
    path: '/',
    sameSite: sameSite(event),
    secure: true,
    'max-age': TWO_YEARS,
    httpOnly: httpOnly
  });
  if (data.generateClientId) {
    setCookie(CLIENT_ID_COOKIE, event.client_id, options(data.httpOnlyCookie || false));
  }
  if (data.exposeFPIDCookie) {
    const fpid = getCookieValues('FPID');
    if (fpid.length) setCookie('FPIDP', fpid[0], options(false));
  }
  if (data.prolongCookies) {
    // Written back in the form it came in: a Synapse Tag older than 1.2.0
    // wrote JSON and reads only JSON, so turning its cookie into pairs here
    // would make that tag drop what was stored. Pairs are already encoded part
    // by part and are written as they are.
    const raw = getCookieValues(STORE_COOKIE, true)[0];
    const stored = storedData();
    if (raw && Object.keys(stored).length) {
      const json = raw.charAt(0) === '{' || raw.indexOf('%7B') === 0;
      if (json) setCookie(STORE_COOKIE, JSON.stringify(stored), options(false));
      else setCookie(STORE_COOKIE, formatStored(stored), options(false), true);
    }
  }
}

// Lax when the tracking host shares the site's registrable domain, otherwise
// the cookie has to be allowed cross-site.
function sameSite(event) {
  if (!event.page_location) return 'lax';
  const host = getRequestHeader('host');
  const site = computeEffectiveTldPlusOne(event.page_location);
  if (!host || !site) return 'lax';
  return host.indexOf(site) !== -1 ? 'lax' : 'none';
}

/*==============================================================================
  Response
==============================================================================*/

function setCorsHeaders(status) {
  setResponseHeader('Access-Control-Max-Age', '600');
  setResponseHeader('Access-Control-Allow-Origin', getRequestHeader('origin'));
  setResponseHeader('Access-Control-Allow-Methods', 'GET,POST,PUT,DELETE,OPTIONS');
  setResponseHeader('Access-Control-Allow-Headers', 'content-type,set-cookie,x-robots-tag,x-gtm-server-preview');
  setResponseHeader('Access-Control-Allow-Credentials', 'true');
  setResponseStatus(status);
}

function respond(status, events, single) {
  if (status === 200 || status === 201) {
    if (method === 'POST' || data.responseBodyGet) writeBody(events, single);
    else setPixelResponse();
  } else if (status === 301 || status === 302) {
    redirect();
  } else if (status === 403 || status === 404) {
    if (data.clientErrorResponseMessage) setResponseBody(data.clientErrorResponseMessage);
  }
}

function writeBody(events, single) {
  if (data.responseBody === 'empty') return;
  setResponseHeader('Content-Type', 'application/json');
  if (data.responseBody === 'eventData') {
    setResponseBody(JSON.stringify(single ? events[0] : events));
    return;
  }
  const summary = (event) => ({ timestamp: event.timestamp, unique_event_id: event.unique_event_id });
  setResponseBody(JSON.stringify(single ? summary(events[0]) : events.map(summary)));
}

function redirect() {
  let location = data.redirectTo;
  if (data.lookupForRedirectToParam && data.redirectToQueryParamName) {
    const target = getRequestQueryParameter(data.redirectToQueryParamName);
    if (target && makeString(target).indexOf('http') === 0) location = target;
  }
  setResponseHeader('location', location);
}


